{
  "name": "ai-sesami",
  "dockerComposeFile": "./docker-compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",

  // Automatically forwards container ports to the host machine.
  "forwardPorts": [5500],

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "ritwickdey.LiveServer"
      ]
    }
  },
  "features": {
    "ghcr.io/prulloac/devcontainer-features/ollama:1.0.1": {}
  },
  // Persisting Ollama Models
  "mounts": ["source=ollama-models,target=/home/node/.ollama,type=volume"]
}
